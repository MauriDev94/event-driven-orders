# ----------------------------------------------------------------------------
# Event-Driven Orders — root environment for docker-compose
# Copy to `.env` and adjust as needed:  cp .env.example .env
# ----------------------------------------------------------------------------

# --- RabbitMQ (shared broker) ---
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
# AMQP URL as seen from inside the compose network (service name = rabbitmq)
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# --- Postgres for order-service (database-per-service) ---
ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=orders
ORDERS_DB_NAME=orders
ORDERS_DB_PORT=5433

# --- Postgres for inventory-service (database-per-service) ---
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=inventory
INVENTORY_DB_NAME=inventory
INVENTORY_DB_PORT=5434

# --- Mailhog (local SMTP capture) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SENDER_EMAIL=no-reply@event-driven-orders.local
