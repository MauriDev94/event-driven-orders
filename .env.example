# ----------------------------------------------------------------------------
# Event-Driven Orders — root environment for docker-compose (local dev)
#
# Don't copy this file by hand: `make env` writes `.env` from it and fills
# every empty *_PASS / *_PASSWORD with a random value (scripts/generate_env.py).
# Secrets never get a value in this file.
# ----------------------------------------------------------------------------

# --- RabbitMQ (shared broker) ---
# docker-compose.yml builds each service's AMQP URL from these two.
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=

# --- Postgres for order-service (database-per-service) ---
ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=
ORDERS_DB_NAME=orders
ORDERS_DB_PORT=5433

# --- Postgres for inventory-service (database-per-service) ---
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=
INVENTORY_DB_NAME=inventory
INVENTORY_DB_PORT=5434

# --- Postgres for assistant-service (database-per-service) ---
ASSISTANT_DB_USER=assistant
ASSISTANT_DB_PASSWORD=
ASSISTANT_DB_NAME=assistant
ASSISTANT_DB_PORT=5435

# --- Redis for assistant-service (rate limit and timeline cache) ---
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Session tokens (ADR-0027) ---
# HS256 key shared by order-service (issues and verifies) and assistant-service.
# `make env` fills it with 32+ random bytes; the services refuse a shorter one.
# Changing it closes every session.
AUTH_TOKEN_SECRET=

# --- Assistant model (ADR-0022) ---
# `fake` answers with fixed rules and needs no key. For Gemini, create a
# free key in Google AI Studio, paste it below and set LLM_PROVIDER=gemini.
# On the free tier Google may use what it receives to improve its
# products: send it test orders only, never real data.
LLM_PROVIDER=fake
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Model calls per minute across all clients: the free tier's limit for the
# default model. Lower it for a model with a lower per-minute quota (ADR-0026).
LLM_MINUTE_CALL_LIMIT=15

# --- assistant-service rate limits (ADR-0023, ADR-0026) ---
# Questions to /ask per IP per minute.
ASK_RATE_LIMIT_PER_MINUTE=5
# Model calls per day across all clients, below the free tier's daily quota.
LLM_DAILY_CALL_LIMIT=400
# Timeline reads per IP per minute. The e2e suite polls it once a second.
TIMELINE_RATE_LIMIT_PER_MINUTE=120

# --- Mailpit (local SMTP capture) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SENDER_EMAIL=no-reply@event-driven-orders.local

# --- Grafana (user: admin) ---
GRAFANA_ADMIN_PASSWORD=
