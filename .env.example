# ----------------------------------------------------------------------------
# Event-Driven Orders — root environment for docker-compose (local dev)
#
# Don't copy this file by hand: `make env` writes `.env` from it and fills
# every empty *_PASS / *_PASSWORD with a random value (scripts/generate_env.py).
# Secrets never get a value in this file.
# ----------------------------------------------------------------------------

# --- RabbitMQ (shared broker) ---
# docker-compose.yml builds each service's AMQP URL from these two.
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=

# --- Postgres for order-service (database-per-service) ---
ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=
ORDERS_DB_NAME=orders
ORDERS_DB_PORT=5433

# --- Postgres for inventory-service (database-per-service) ---
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=
INVENTORY_DB_NAME=inventory
INVENTORY_DB_PORT=5434

# --- Postgres for assistant-service (database-per-service) ---
ASSISTANT_DB_USER=assistant
ASSISTANT_DB_PASSWORD=
ASSISTANT_DB_NAME=assistant
ASSISTANT_DB_PORT=5435

# --- Mailpit (local SMTP capture) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SENDER_EMAIL=no-reply@event-driven-orders.local

# --- Grafana (user: admin) ---
GRAFANA_ADMIN_PASSWORD=
