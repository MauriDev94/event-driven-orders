# ----------------------------------------------------------------------------
# Event-Driven Orders — variables de entorno de PRODUCCIÓN
#
# Copiar a `.env.production` (en la raíz del repo) y completar con valores reales:
#   cp deploy/env.production.example .env.production
#
# Uso:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#     --env-file .env.production up -d --build
#
# NUNCA commitear `.env.production` (ya está en .gitignore).
# ----------------------------------------------------------------------------

# --- Dominio / TLS -----------------------------------------------------------
# Dominio público de la VM. Opciones:
#   - sslip.io (gratis, sin registrar dominio): "<ip-con-guiones>.sslip.io"
#     ej. si la IP pública es 203.0.113.10 -> DOMAIN=203-0-113-10.sslip.io
#   - DuckDNS: "<subdominio>.duckdns.org"
#   - Dominio propio apuntando con un registro A a la IP pública de la VM
DOMAIN=203-0-113-10.sslip.io

# --- RabbitMQ -----------------------------------------------------------------
# Credenciales del broker (NUNCA usar guest/guest en producción).
RABBITMQ_DEFAULT_USER=edo_broker_admin
RABBITMQ_DEFAULT_PASS=CHANGE_ME_use_a_long_random_password
# Connection string que usan los 3 servicios para conectarse al broker.
RABBITMQ_URL=amqp://edo_broker_admin:CHANGE_ME_use_a_long_random_password@rabbitmq:5672/

# --- Basic auth: RabbitMQ Management UI (vía Caddy) ---------------------------
RABBITMQ_UI_USER=admin
# Hash bcrypt del password (NO el password en texto plano). Generar con:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# IMPORTANTE: Docker Compose interpola "$" como inicio de variable, así que
# cada "$" del hash bcrypt ($2a$14$...) debe escaparse duplicándolo ("$$").
# Ej: si el hash generado es "$2a$14$abc123...", acá va "$$2a$$14$$abc123...".
RABBITMQ_UI_PASSWORD_HASH=$$2a$$14$$CHANGE_ME_replace_with_a_real_bcrypt_hash

# --- Basic auth: Mailhog UI (vía Caddy) ----------------------------------------
MAILHOG_UI_USER=admin
# Hash bcrypt del password (NO el password en texto plano). Mismo comando y
# mismo escapado de "$" -> "$$" que arriba.
MAILHOG_UI_PASSWORD_HASH=$$2a$$14$$CHANGE_ME_replace_with_a_real_bcrypt_hash

# --- Postgres: order-service ----------------------------------------------------
ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=CHANGE_ME_use_a_long_random_password
ORDERS_DB_NAME=orders_db
# Puerto interno. docker-compose.prod.yml elimina el port mapping al host;
# esta variable se mantiene por compatibilidad con docker-compose.yml (dev).
ORDERS_DB_PORT=5433

# --- Postgres: inventory-service -------------------------------------------------
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=CHANGE_ME_use_a_long_random_password
INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_PORT=5434

# --- notification-service / Mailhog ------------------------------------------------
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SENDER_EMAIL=no-reply@example.com
