# ----------------------------------------------------------------------------
# Event-Driven Orders — Caddy reverse proxy (producción)
#
# Caddy obtiene certificados HTTPS automáticamente vía Let's Encrypt para
# cada dominio declarado abajo (HTTP-01 challenge sobre el puerto 80).
#
# {$DOMAIN} debe resolver a la IP pública de la VM. Con sslip.io alcanza con
# usar "<ip-con-guiones>.sslip.io" como DOMAIN (ej: 203-0-113-10.sslip.io);
# los subdominios "mailpit.<DOMAIN>" / "grafana.<DOMAIN>" resuelven a la misma
# IP automáticamente.
#
# La UI de RabbitMQ no pasa por acá: se entra por túnel SSH (ver
# docker-compose.prod.yml).
#
# Generar los hashes de basic auth con:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext '<password>'
# y pegar el resultado (incluye el prefijo $2a$...) en MAILPIT_UI_PASSWORD_HASH
# / GRAFANA_UI_PASSWORD_HASH dentro de .env.production.
# ----------------------------------------------------------------------------

# --- API pública: order-service (con Swagger) y assistant-service ----------
# El asistente comparte el dominio, así que un frontend no necesita CORS. Solo
# se publica /v1/assistant/*: su /health y su /metrics no salen a internet.
# Caddy reemplaza el X-Forwarded-For que mande el cliente por su IP real, y el
# asistente lo lee con TRUST_PROXY=uniquelocal para el rate limit (ADR-0023).
#
# request_body corta en Caddy cualquier body de más de 64 000 bytes (KB es SI,
# no KiB), con 413 y sin pasarlo al servicio, aunque venga chunked sin
# Content-Length. uvicorn no limita el body (el de Express, en el asistente,
# corta recién en 100 kb), y el pedido válido más grande queda muy por debajo
# de ese tope (issue #80).
{$DOMAIN} {
	request_body {
		max_size 64KB
	}
	handle /v1/assistant/* {
		reverse_proxy assistant-service:8000
	}
	handle {
		reverse_proxy order-service:8000
	}
}

# --- Mailpit UI: protegido con basic auth -----------------------------------
mailpit.{$DOMAIN} {
	basic_auth {
		{$MAILPIT_UI_USER} {$MAILPIT_UI_PASSWORD_HASH}
	}
	reverse_proxy mailpit:8025
}

# --- Grafana: protegido con basic auth, y después el login de Grafana -------
grafana.{$DOMAIN} {
	basic_auth {
		{$GRAFANA_UI_USER} {$GRAFANA_UI_PASSWORD_HASH}
	}
	# Grafana lee un header Basic como su propio login (auth.basic): cada request
	# con las credenciales de Caddy cuenta como un intento fallido del usuario
	# admin, y a los pocos Grafana lo bloquea. Grafana no recibe este header.
	reverse_proxy grafana:3000 {
		header_up -Authorization
	}
}
